# DB_TIMEZONE=Asia/Bangkok
# DB_SSL=false
# DB_SYNCHRONIZE=false

# JWT_SECRET= สุ่มใหม่ให้ยาวๆ
# JWT_EXPIRES_IN=1d

# UPLOAD_DIR=./uploads
# STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# MAX_FILE_SIZE_MB=5
# MAX_FILES_PER_TICKET=5

# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=60
# SSE_MAX_CONNECTIONS_PER_CLIENT=5
# SSE_MAX_CONNECTIONS_TOTAL=500

# LINE_LOGIN_CHANNEL_ID=2010638501

# เวลาทำการ SLA คำนวณตาม timezone ของ process - ต้องตั้งให้ตรงเวลาไทย ไม่งั้นบนเซิร์ฟเวอร์ UTC จะเลื่อน 7 ชม.
# TZ=Asia/Bangkok
# SLA_URGENT_24_7=true
# SLA_WORK_START_HOUR=8
# SLA_WORK_START_MINUTE=30
# SLA_WORK_END_HOUR=17
# SLA_WORK_END_MINUTE=30

